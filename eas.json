{
  "cli": {
    "version": ">= 18.1.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "developmentClient": false,
      "android": {
        "buildType": "apk"
      },
      "distribution": "store",
      "autoIncrement": true,
      "environment": "preview"
    },
    "production": {
      "developmentClient": false,
      "android": {
        "buildType": "app-bundle"
      },
      "distribution": "store",
      "autoIncrement": true,
      "environment": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "...",
        "appleTeamId": "..."
      }
    },
    "preview": {
      "ios": {
        "ascAppId": "...",
        "appleTeamId": "..."
      }
    }
  }
}
